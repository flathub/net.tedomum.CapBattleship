{
    "app-id": "net.tedomum.CapBattleship",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "capbattleship",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--share=ipc",
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/python3.*/*/pygame/docs",
        "/lib/python3.*/*/pygame/examples",
        "/lib/python3.*/*/pygame/tests"
    ],
    "modules": [
        "SDL2.json",
        "shared-modules/SDL2/SDL2_ttf.json",
        "shared-modules/SDL2/SDL2_image.json",
        "shared-modules/SDL2/SDL2_mixer.json",
        {
            "name": "python3-pygame",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pygame\" --no-build-isolation"
            ],
            "build-options": {
                "env": {
                    "PYGAME_EXTRA_BASE": "/app"
                },
                "arch": {
                    "aarch64": {
                        "env": {
                            "ORIGLIBDIRS": "/lib:/lib64:/lib/aarch64-linux-gnu"
                        }
                    },
                    "x86_64": {
                        "env": {
                            "ORIGLIBDIRS": "/lib:/lib64:/lib/x86_64-linux-gnu"
                        }
                    }
                }
            },
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/49/cc/08bba60f00541f62aaa252ce0cfbd60aebd04616c0b9574f755b583e45ae/pygame-2.6.1.tar.gz",
                    "sha256": "56fb02ead529cee00d415c3e007f75e0780c655909aaa8e8bf616ee09c9feb1f"
                }
            ]
        },
        {
            "name": "capbattleship",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-build-isolation --prefix=/app ."
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://forge.tedomum.net/cap-pirate-battleship/capbattleship",
                    "tag": "v1.0alpha8",
                    "commit": "6fadd5ac97297b21be12ae7835e751e014a806ca"
                },
                {
                    "type": "patch",
                    "paths": [
                        "usr-app.patch",
                        "disable-repeat-background-music-option.patch",
                        "fix-appdata.patch"
                    ]
                }
            ]
        }
    ]
}
